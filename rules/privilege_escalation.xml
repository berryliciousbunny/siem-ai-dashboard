<group name="local,windows,privilege_escalation,">

  <!-- UC-003a: Special/admin privileges assigned to a logon -->
  <rule id="100003" level="9">
    <if_sid>60155</if_sid>
    <description>Special privileges assigned to new logon — possible privilege escalation</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pci_dss_10.2.5,</group>
  </rule>

  <!-- UC-003b: User added to a privileged group (e.g. Administrators) -->
  <rule id="100004" level="10">
    <if_sid>60129</if_sid>
    <match>Administrators</match>
    <description>User added to privileged group (Administrators) — possible unauthorized privilege escalation</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>privilege_escalation,account_changed,</group>
  </rule>

  <!-- UC-003c: Sudo/root activity (Linux endpoints, if any are added later) -->
  <rule id="100005" level="9">
    <if_sid>5402</if_sid>
    <description>Sudo command executed — review for unauthorized privilege escalation</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>privilege_escalation,linux,</group>
  </rule>

</group>